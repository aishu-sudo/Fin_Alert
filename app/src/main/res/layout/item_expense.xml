<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="8dp"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/ivExpIcon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@drawable/ic_groceries"
        android:background="@drawable/circle_80"
        android:padding="8dp" />

    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="8dp">
        <TextView android:id="@+id/tvExpTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Title" android:textStyle="bold"/>
        <TextView android:id="@+id/tvExpSub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="time - date" android:textSize="12sp" android:textColor="#666666"/>
    </LinearLayout>

    <TextView android:id="@+id/tvExpAmount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-$0.00" android:textStyle="bold"/>

</LinearLayout>

