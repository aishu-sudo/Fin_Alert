<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/green_gradient2">

    <!-- Header Section -->
    <LinearLayout
        android:id="@+id/headerSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="36dp"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingBottom="20dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_back"
                android:padding="8dp"
                android:background="@drawable/circular_bg"
                app:tint="#FFFFFF"
                android:contentDescription="Back"/>

            <TextView
                android:id="@+id/tvCategoryTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Food"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:gravity="center"/>

            <ImageView
                android:id="@+id/notificationIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_notification"
                android:padding="8dp"
                android:background="@drawable/circular_bg"
                app:tint="#FFFFFF"
                android:contentDescription="Notifications"/>
        </LinearLayout>

        <!-- Balance and Expense Cards -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="20dp"
            android:background="@drawable/card_header_bg">

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical"
                android:padding="12dp">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <ImageView android:layout_width="12dp" android:layout_height="12dp"
                        android:src="@drawable/ic_wallet" app:tint="#FFFFFF"
                        android:contentDescription="Wallet" android:layout_marginEnd="6dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Total Balance" android:textColor="#FFFFFF"
                        android:textSize="11sp" android:alpha="0.9"/>
                </LinearLayout>
                <TextView
                    android:id="@+id/tvTotalBalance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$7,783.00"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- Vertical divider -->
            <View
                android:layout_width="1dp"
                android:layout_height="44dp"
                android:background="#40FFFFFF"
                android:layout_gravity="center_vertical"/>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical"
                android:padding="12dp">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <ImageView android:layout_width="12dp" android:layout_height="12dp"
                        android:src="@drawable/ic_expense" app:tint="#FFFFFF"
                        android:contentDescription="Expense" android:layout_marginEnd="6dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Total Expense" android:textColor="#FFFFFF"
                        android:textSize="11sp" android:alpha="0.9"/>
                </LinearLayout>
                <TextView
                    android:id="@+id/tvTotalExpense"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-$1,187.40"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Progress Bar Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:orientation="horizontal"
            android:background="@drawable/progress_bar_track_bg"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp"
            android:paddingStart="6dp"
            android:paddingEnd="10dp">

            <TextView
                android:id="@+id/tvProgressPercent"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/percentage_bg"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="30%"
                android:textColor="#33D49C"
                android:textSize="12sp"
                android:textStyle="bold"/>

            <View
                android:id="@+id/progressFill"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_weight="0.30"
                android:background="#33D49C"
                android:layout_marginStart="8dp"
                android:clipToPadding="true"/>

            <View
                android:id="@+id/progressEmpty"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_weight="0.70"
                android:background="#2A6B52"/>

            <TextView
                android:id="@+id/tvBudget"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$20,000.00"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <!-- Status Row (checkbox + text) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">
            <CheckBox
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:checked="true"
                android:buttonTint="#FFD600"
                android:focusable="false"
                android:clickable="false"
                android:layout_marginEnd="8dp"/>
            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="30% Of Your Expenses, Looks Good."
                android:textColor="#FFFFFF"
                android:textSize="11sp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Navigation -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:gravity="center"
        android:elevation="8dp">

        <ImageView android:id="@+id/navHome" android:layout_width="0dp"
            android:layout_height="28dp" android:layout_weight="1"
            android:src="@drawable/ic_home" app:tint="#666666"
            android:padding="2dp" android:contentDescription="Home"/>
        <ImageView android:id="@+id/navAnalytics" android:layout_width="0dp"
            android:layout_height="28dp" android:layout_weight="1"
            android:src="@drawable/ic_analytics" app:tint="#666666"
            android:padding="2dp" android:contentDescription="Analytics"/>
        <ImageView android:id="@+id/navTransfer" android:layout_width="0dp"
            android:layout_height="28dp" android:layout_weight="1"
            android:src="@drawable/ic_transfer" app:tint="#666666"
            android:padding="2dp" android:contentDescription="Transfer"/>

        <!-- Selected tab with circular bg to match screenshot -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_gravity="center"
            android:padding="4dp">
            <View
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/nav_selected_bg"
                android:layout_gravity="center"/>
            <ImageView android:id="@+id/navLayers" android:layout_width="28dp"
                android:layout_height="28dp" android:src="@drawable/ic_layers"
                android:layout_gravity="center"
                android:contentDescription="Layers"
                app:tint="#FFFFFF" />
        </FrameLayout>

        <ImageView android:id="@+id/navProfile" android:layout_width="0dp"
            android:layout_height="28dp" android:layout_weight="1"
            android:src="@drawable/ic_profile" app:tint="#666666"
            android:padding="2dp" android:contentDescription="Profile"/>
    </LinearLayout>

    <!-- Main Content with rounded top corners -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/headerSection"
        android:layout_above="@id/bottomNav"
        android:fillViewport="true"
        android:background="@drawable/rounded_top_bg">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@android:color/transparent"
            android:paddingStart="24dp" android:paddingEnd="24dp"
            android:paddingTop="12dp" android:paddingBottom="16dp">

            <!-- Month header (left month title, right calendar icon) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/tvMonth"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="April"
                    android:textSize="16sp"
                    android:textColor="#111111"
                    android:fontFamily="sans-serif-medium"/>

                <ImageView
                    android:id="@+id/ivCalendar"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/material_ic_calendar_black_24dp"
                    android:background="@drawable/circle_gray_bg"
                    android:padding="6dp"
                    android:contentDescription="Calendar"/>
            </LinearLayout>

            <!-- Expenses list -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvExpenses"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"/>

            <!-- Add expense centered button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="12dp">

                <Button
                    android:id="@+id/btnAddExpense"
                    android:layout_width="160dp"
                    android:layout_height="44dp"
                    android:text="Add Expenses"
                    android:background="@drawable/btn_green"
                    android:textColor="#FFFFFF"/>
            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</RelativeLayout>
