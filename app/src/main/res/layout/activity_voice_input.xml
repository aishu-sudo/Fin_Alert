<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/green_gradient2">

    <!-- Green Header Area (tall - holds back + title, circle overlaps it) -->
    <RelativeLayout
        android:id="@+id/headerArea"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_alignParentTop="true">

        <!-- Back Arrow -->
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_back"
            app:tint="#FFFFFF"
            android:layout_alignParentStart="true"
            android:layout_marginStart="16dp"
            android:layout_marginTop="36dp"
            android:padding="8dp"
            android:contentDescription="Back"/>

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Voice Input"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="44dp"/>
    </RelativeLayout>

    <!-- White Rounded Card (overlaps header bottom) -->
    <LinearLayout
        android:id="@+id/contentCard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="170dp"
        android:background="@drawable/voice_card_bg"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="40dp"
        android:paddingBottom="32dp"
        android:paddingStart="28dp"
        android:paddingEnd="28dp">

        <!-- Status Text (Speak Now / Redo Voice Command / empty) -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#1A1A1A"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="32dp"/>

        <!-- Mic / Redo Circle (clickable for redo) -->
        <LinearLayout
            android:id="@+id/micCircle"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:background="@drawable/circle_teal_bg"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivMicIcon"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/ic_mic"
                app:tint="#FFFFFF"
                android:contentDescription="Microphone"/>
        </LinearLayout>

        <!-- Spacer to push fields/buttons down -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.2"/>

        <!-- Result Fields (GONE initially, shown after voice result) -->
        <EditText
            android:id="@+id/etResultAmount"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Amount (e.g. 250)"
            android:textSize="14sp"
            android:background="@drawable/add_expense_input_bg"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:inputType="numberDecimal"
            android:layout_marginBottom="12dp"
            android:visibility="gone"/>

        <!-- Category Spinner (dropdown) -->
        <Spinner
            android:id="@+id/spinnerCategory"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/add_expense_input_bg"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:layout_marginBottom="24dp"
            android:visibility="gone"/>

        <!-- Save Button (shown after result) -->
        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Save"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#DFF7E2"
            android:stateListAnimator="@null"
            android:layout_marginBottom="12dp"
            android:visibility="gone"/>

        <!-- Cancel Button (shown after result) -->
        <Button
            android:id="@+id/btnCancel"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Cancel"
            android:textColor="#1A1A1A"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#DFF7E2"
            android:stateListAnimator="@null"
            android:layout_marginBottom="12dp"
            android:visibility="gone"/>

        <!-- Start/Stop Button (always visible) -->
        <Button
            android:id="@+id/btnStartStop"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Start"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#33D49C"
            android:stateListAnimator="@null"/>

    </LinearLayout>

</RelativeLayout>
